    "expo-image": "~55.0.0",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.0",
    "expo-constants": "~55.0.0",
    "expo-linking": "~55.0.0",
    "react": "19.2.6",
    "react-native": "0.81.6",
    "react-native-unistyles": "^3.0.0",
    "react-native-reanimated": "^4.0.0",
